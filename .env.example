# --- Database ---
# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/authdock"

# --- Sessions ---
# Long, random secret used to sign/encrypt cookie sessions.
# Generate one with: openssl rand -base64 32
# In production, boot fails if this is missing OR left at an obvious placeholder.
SESSION_SECRET="change-me-generate-a-real-secret"

# 'cookie' (default) or 'jwt' — see the architecture doc for the trade-offs.
SESSION_STRATEGY="cookie"

# --- Email (verification + password reset) ---
# Get a free key at https://resend.com — required in production.
RESEND_API_KEY=""
# Optional: defaults to Resend's shared sandbox sender if unset.
RESEND_FROM="onboarding@resend.dev"

# --- App URLs ---
# Used to build verification/reset links that point back at the frontend.
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000/api"

# --- Environment ---
# 'development' unlocks safe fallbacks (emails logged to console instead of sent,
# relaxed secret checks). Never set anything but 'production' in production.
NODE_ENV="development"
